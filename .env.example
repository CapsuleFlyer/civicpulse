# CivicPulse — environment template.
#
# Copy to .env and fill in. `.env` is gitignored and must stay that way:
# a credential in git history is a -20 deduction plus a rotation you do not
# want to be doing at 2 a.m.
#
#     cp .env.example .env
#
# Every value below is either safe to publish or a deliberate placeholder.

# --- database -------------------------------------------------------------
# Used by the postgres container to initialise the cluster, and by the backend
# to build DATABASE_URL. The hostname is `database` — the Compose service name,
# never localhost, because these processes live in different network namespaces.
POSTGRES_USER=civic
POSTGRES_PASSWORD=change-me-before-you-run-this-anywhere-real
POSTGRES_DB=civicpulse

# --- triage provider ------------------------------------------------------
# rules      — deterministic keyword table. No network, no key. The default.
# llm        — hosted model over an OpenAI-compatible endpoint (Groq, Gemini,
#              OpenRouter...). Requires LLM_API_KEY.
# ollama     — fully offline model in the `ollama` container. No key, slower,
#              and noticeably worse at classification. That is the lesson.
# simulated  — deterministic fake used by CI. Never use it in production.
TRIAGE_PROVIDER=rules

# Only read when TRIAGE_PROVIDER=llm. Get one free, no credit card, at
# https://console.groq.com. Never commit the real value.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant
LLM_PROVIDER_LABEL=llm:groq

# Only read when TRIAGE_PROVIDER=ollama.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:1b

# Only read when TRIAGE_PROVIDER=simulated. `simulated_failure_mode` is how the
# test suite drives the fallback path without a network:
# none | raise | malformed | timeout
SIMULATED_SEED=1337
SIMULATED_FAILURE_MODE=none

# --- triage policy --------------------------------------------------------
TRIAGE_TIMEOUT_SECONDS=10
TRIAGE_MAX_RETRIES=1
TRIAGE_CACHE_TTL_SECONDS=86400

# --- cache and rate limiting ---------------------------------------------
STATS_CACHE_TTL_SECONDS=30
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# --- runtime --------------------------------------------------------------
LOG_LEVEL=INFO
ENVIRONMENT=development

# Frontend runtime configuration. The frontend proxies /api through its own
# nginx, so this is a path and not an absolute URL — see docs/adr/0002.
# Change it only if you mount the API somewhere else.
API_BASE_URL=/api

# --- images ---------------------------------------------------------------
# compose.prod.yaml refuses to start without IMAGE_TAG. Set it to a commit SHA,
# never to `latest`: "what is production running?" must have an answer you can
# paste into `git show`.
REGISTRY=ghcr.io/your-org
IMAGE_TAG=
